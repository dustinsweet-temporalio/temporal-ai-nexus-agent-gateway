# Copy to .env (make setup does this if .env is missing). Every process loads .env
# at startup. Everything here is optional: the defaults run the key-free local demo.

# Which connection profile in config/profiles/ to use. Optional. Default: local, the
# Temporal dev server, which is the only profile this repo has been tested with.
PROFILE=local

# --- Ports. Change one if something else on your machine already uses it. -------

# The local dev server's gRPC port. Optional. Default: 7233. Local profile only.
TEMPORAL_PORT=7233
# The local dev server's Web UI. Optional. Default: 8233. Local profile only.
TEMPORAL_UI_PORT=8233
# The gateway's MCP front door (http://localhost:<port>/mcp). Optional. Default: 8080.
# Claude Code's `claude mcp add` command must use the same port (make mcp-command prints it).
GATEWAY_PORT=8080
# The release console (http://localhost:<port>). Optional. Default: 8090.
CONSOLE_PORT=8090
# Set to record to open the console in its fixed 1920x1080 layout by default.
# Optional. Default: normal. ?mode=record in the URL does the same.
CONSOLE_MODE=normal

# --- Gateway behavior ----------------------------------------------------------

# How long a tool call may run before the gateway hands it back as a call handle.
# Optional. Default: 5. Keep it shorter than a staging deployment to see the handoff.
SYNC_BUDGET_SECONDS=5
# A session with no pending calls closes after this many seconds without a call;
# the next call starts a fresh one. Optional. Default: 86400 (24 hours).
SESSION_IDLE_CLOSE_SECONDS=86400

# --- Simulated work ----------------------------------------------------------------

# How long a simulated deployment takes, per environment. Optional. Defaults: 8 and 12.
DEPLOY_SECONDS_STAGING=8
DEPLOY_SECONDS_PRODUCTION=12
# How long each of the mock reviewer's three steps takes. Optional. Default: 5.
# Shorter makes it hard to stop the Security Worker during step 2 of a review.
REVIEW_STEP_SECONDS=5

# --- Security's reviewer agent -------------------------------------------------------

# mock (default, key-free, $0) or claude (calls the Anthropic API and costs money).
# Optional. The console's top bar shows which is active.
REVIEWER=mock
# The Claude model for REVIEWER=claude. Optional. Default: claude-sonnet-5-5.
REVIEWER_MODEL=claude-sonnet-5-5
# Required only for REVIEWER=claude. Without it, the Security Worker stops at startup
# with "REVIEWER=claude needs ANTHROPIC_API_KEY in .env". Never commit it.
ANTHROPIC_API_KEY=

# --- Local files --------------------------------------------------------------------

# Where the simulated CD system keeps its records, and where the demo supervisor
# listens (supervisor.sock). Optional. Default: .demo-state/ in the repo (make reset clears it).
DEMO_STATE_DIR=
